---
import Base from "../layouts/Base.astro";
import { CATEGORIES, COLUMNS, DEFAULT_STATE, categoryCounts, categoryStatus, toListRow } from "../lib/list.ts";
import { typeSymbols } from "../lib/type-icons.ts";
import { loadDataset } from "../site/load-dataset.ts";

const dataset = loadDataset();
const rows = dataset.pokemon.map(toListRow);
const counts = categoryCounts(rows);
const number = new Intl.NumberFormat("en");
const home = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
// "<" can't close the script tag once it's escaped, whatever the data contains.
const json = JSON.stringify(rows).replace(/</g, "\\u003c");
---

<Base>
  <section class="intro">
    <h1>How well do a Pokémon's stats translate into GO?</h1>
    <p>
      Pokémon GO turns six main-series stats into three, and some stat spreads lose more in the change than others. GO
      Fit scores how close each Pokémon comes to the best spread of its own stat points. The closer to 100%, the better
      its stats carry over.
    </p>
  </section>

  <div
    class="categories"
    id="list-categories"
    role="group"
    aria-label="Categories"
    aria-describedby="list-categories-hint"
  >
    <div class="pills">
      {CATEGORIES.map((category) => {
        const status = categoryStatus(DEFAULT_STATE, category.id);
        return (
          <button
            type="button"
            class="pill"
            data-category={category.id}
            data-state={status}
            aria-pressed={String(status === "on")}
          >
            <span class="pill-mark" aria-hidden="true">
              −
            </span>
            <span class="pill-label">{category.label}</span>
            <small>{number.format(counts[category.id])}</small>
            <span class="sr-only pill-excluded" hidden>
              (left out)
            </span>
          </button>
        );
      })}
      <p class="categories-hint" aria-hidden="true">
        Double-click to leave one out
      </p>
    </div>
    <p class="sr-only" id="list-categories-hint">
      Select several categories to see forms in any of them. Double-click one, or press Shift+Enter, to leave it out.
    </p>
  </div>

  <div class="toolbar">
    <div class="search">
      <label class="sr-only" for="list-search">
        Search by name or dex number
      </label>
      <input
        id="list-search"
        type="search"
        placeholder="Search by name or dex number"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
    <div class="sort">
      <label>
        <span class="sr-only">Sort by</span>
        <select id="list-sort">
          {COLUMNS.map((column) => (
            <option value={column.key}>{`Sort by ${column.label}`}</option>
          ))}
        </select>
      </label>
      <button type="button" id="list-direction">
        Descending
      </button>
    </div>
    <p class="count" id="list-count" role="status">
      {number.format(rows.length)} forms
    </p>
    <p class="hint">
      CP is at level 50 with perfect IVs. <a href={`${home}about/`}>How it's calculated</a>
    </p>
  </div>

  <noscript>
    <p>
      This list needs JavaScript. The <a href={`${home}about/`}>About page</a> works without it, and the data is
      available as <a href={`${home}data/pokemon.json`}>JSON</a>.
    </p>
  </noscript>

  <table class="list" id="list-table">
    <caption class="sr-only">
      GO Fit for each Pokémon form. Select a column heading to sort, or a row to see its stats.
    </caption>
    <thead id="list-head">
      <tr>
        {COLUMNS.map((column) => (
          <th scope="col" data-key={column.key} class={`col-${column.key}`} title={column.hint}>
            <button type="button">
              <span class:list={[{ "sr-only": column.key === "dex" }]}>
                {column.key === "dex" ? column.label : column.short}
              </span>
              {column.key === "dex" && <span aria-hidden="true">#</span>}
              <span class="arrow" aria-hidden="true" />
            </button>
          </th>
        ))}
      </tr>
    </thead>
    <tbody id="list-body" data-base={home}></tbody>
  </table>

  <nav class="pager" id="list-pager" aria-label="Pages" hidden></nav>

  <div class="empty" id="list-empty" hidden>
    <p>No forms match. Try a shorter search or fewer categories.</p>
    <button type="button" class="button" id="list-clear">
      Show all forms
    </button>
  </div>

  <svg class="sprite" id="type-icons" aria-hidden="true" focusable="false" set:html={typeSymbols()} />
  <script is:inline type="application/json" id="list-data" set:html={json} />
  <script src="../site/list-page.ts"></script>
</Base>
