---
// Six strands merging into three: the six main-series stats becoming GO's three.
---

<svg class="logo-mark" viewBox="0 0 64 56" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="logo-strand" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="64" y2="0">
      <stop offset="0" stop-color="var(--logo-from)"></stop>
      <stop offset="0.75" stop-color="var(--logo-to)"></stop>
    </linearGradient>
  </defs>
  <g fill="none" stroke="url(#logo-strand)" stroke-width="4.5" stroke-linecap="round">
    <path d="M3 4.5h9c11 0 11 8 22 8h27"></path>
    <path d="M3 13.5h9c11 0 11 3.5 22 3.5h27"></path>
    <path d="M3 23h9c11 0 11 3 22 3h27"></path>
    <path d="M3 33h9c11 0 11-3 22-3h27"></path>
    <path d="M3 42.5h9c11 0 11-3.5 22-3.5h27"></path>
    <path d="M3 51.5h9c11 0 11-8 22-8h27"></path>
  </g>
</svg>
