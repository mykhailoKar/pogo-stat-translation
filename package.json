{
  "name": "pogo-stat-translation",
  "private": true,
  "version": "0.1.0",
  "description": "Judges how well every main-series Pokémon's base stats convert into Pokémon GO.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "fetch": "node pipeline/fetch.ts",
    "fetch:update": "node pipeline/fetch.ts --update",
    "build:data": "node pipeline/build.ts",
    "draw:logo": "node scripts/draw-logo.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build:data && npm test && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "astro": "^7.4.7",
    "csv-parse": "^7.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.91.0",
    "playwright-core": "^1.65.0",
    "typescript": "~7.0.2"
  }
}
